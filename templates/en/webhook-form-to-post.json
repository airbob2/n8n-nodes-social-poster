              "id": "d30cdbc3-9f39-4a43-bb38-f0f39d5c37c5",
              "name": "caption",
              "type": "string",
              "value": "={{ $json.body.caption || $json.caption || $json.body.text || $json.text || $json.body.message || $json.message }}"
            },
            {
              "id": "376be6f3-5427-48e5-a49f-0e2f3398ddf4",
              "name": "link",
              "type": "string",
              "value": "={{ $json.body.link || $json.link || $json.body.url || $json.url || \"\" }}"
            },
            {
              "id": "c33d641f-94bf-4c63-a571-03282defd194",
              "name": "mediaUrls",
              "type": "string",
              "value": "={{ $json.body.media_urls || $json.body.mediaUrls || $json.media_urls || $json.mediaUrls || $json.body.image || $json.image || \"\" }}"
            },
            {
              "id": "d97b19c2-b075-4d2a-a7a1-b4981b8aaafe",
              "name": "title",
              "type": "string",
              "value": "={{ $json.body.title || $json.title || \"\" }}"
            },
            {
              "id": "f04b28a6-44aa-4844-b1b9-5ad5b97ec770",
              "name": "requestAllowsSchedule",
              "type": "boolean",
              "value": "={{ ![\"false\", false, \"0\", 0].includes(($json.body && $json.body.schedule !== undefined) ? $json.body.schedule : ($json.schedule === undefined ? true : $json.schedule)) }}"
            }
          ]
        }
      }
    },
    {
      "id": "316a530b-2b66-5a7f-9bea-6b439258eeeb",
      "name": "Create the draft",
      "type": "n8n-nodes-social-poster.socialPoster",
      "typeVersion": 1,
      "position": [
        1360,
        320
      ],
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "workspace": "",
        "account": "={{ $json.accountRef }}",
        "caption": "={{ $json.caption }}",
        "additionalFields": {
          "link": "={{ $json.link }}",
          "mediaUrls": "={{ $json.mediaUrls }}",
          "title": "={{ $json.title }}"
        }
      },
      "credentials": {
        "socialPosterApi": {
          "id": "YOUR_SOCIAL_POSTER_CREDENTIAL",
          "name": "Social Poster API"
        }
      }
    },
    {
      "id": "46f644eb-9c37-5e32-a494-dff2774a72fc",
      "name": "Should it be scheduled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1640,
        320
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": false,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "7515db33-5b37-5176-8b3b-fd05c669590c",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ String($('Settings and fields').item.json.mode || \"\").trim().toLowerCase() }}",
              "rightValue": "schedule"
            },
            {
              "id": "e05d7c3d-eb0b-51d5-b26d-5a7859db7484",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $('Settings and fields').item.json.requestAllowsSchedule }}",
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "2e829d30-92f0-5b31-9ece-c49447ac5b30",
      "name": "Schedule the draft",
      "type": "n8n-nodes-social-poster.socialPoster",
      "typeVersion": 1,
      "position": [
        1920,
        200
      ],
      "parameters": {
        "resource": "post",
        "operation": "scheduleDraft",
        "workspace": "",
        "draftRef": "={{ $('Create the draft').item.json.draft.draft_ref }}",
        "scheduleMode": "minutes",
        "minutesFromNow": "={{ $('Settings and fields').item.json.minutesFromNow }}",
        "xContentReviewed": false
      },
      "credentials": {
        "socialPosterApi": {
          "id": "YOUR_SOCIAL_POSTER_CREDENTIAL",
          "name": "Social Poster API"
        }
      }
    },
    {
      "id": "d6fc0c1d-60ae-4eb1-b86e-0d734f7ccb96",
      "name": "Respond with success",
