      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        460,
        780
      ],
      "parameters": {
        "content": "If n8n is reachable from the internet, add authentication on the Webhook node. Never send the Social Poster key in the request.",
        "height": 220,
        "width": 560,
        "color": 3
