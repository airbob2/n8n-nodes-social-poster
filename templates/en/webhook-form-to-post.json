              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.body.message || $json.message }}",
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "fe05436e-07c7-480d-88d5-7a3b2752fc99",
