      "typeVersion": 1.1,
      "position": [
        2200,
        320
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, draft_ref: $('Create the draft').item.json.draft.draft_ref, status_class: $json.status_class || ($json.draft && $json.draft.status_class) || \"draft\", scheduled_at_utc: $json.scheduled_at_utc || null, approval_class: $json.approval_class || null } }}",
        "options": {
          "responseCode": 200
        }
      }
    }
