      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1100,
        60
      ],
      "parameters": {
        "content": "## Account and content\nThe account reference and lead time live here. The caption comes from the request, not from the credentials.",
        "height": 240,
        "width": 480,
        "color": 7
      }
    },
    {
      "id": "576da42f-e223-41bb-a61b-6d6c5dcc787a",
      "name": "Draft or schedule",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1660,
        60
      ],
      "parameters": {
        "content": "## Two paths\n`schedule` true or omitted schedules the post. `schedule` false creates a draft only. Both paths return the draft id.",
        "height": 240,
        "width": 720,
        "color": 7
      }
    },
    {
      "id": "db62ba94-a747-4cf9-b67f-1d5585d89d5c",
