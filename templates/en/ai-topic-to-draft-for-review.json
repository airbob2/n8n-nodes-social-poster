      ],
      "parameters": {
        "formTitle": "Draft a post from a topic",
        "formDescription": "Writes a caption with AI and saves it in Social Poster as a draft.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Topic",
              "placeholder": "For example: spring offers in the farm shop",
              "requiredField": true
            },
            {
              "fieldType": "textarea",
              "fieldLabel": "Notes",
              "placeholder": "Tone, language, things to include or avoid"
            }
          ]
        },
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thanks. The draft is being created in Social Poster."
            }
          }
        }
      },
      "webhookId": "b3809393-dcd5-464e-afb7-8e76a049ee34"
    },
    {
