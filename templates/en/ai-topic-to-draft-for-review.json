    {
      "id": "fc856472-4805-4a3f-9c97-4cfd5a84e889",
      "name": "Write the post text",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1360,
        400
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "=You write a social media post for Social Poster. Return only the finished post text, with no quotation marks, no heading such as “Post:”, and no explanation.\n\nUse the following brand and network context from Social Poster where it is available:\n{{ JSON.stringify($json) }}\n\nTopic:\n{{ $('Settings').item.json.Topic }}\n\nAdditional notes from the person using this workflow:\n{{ $('Settings').item.json.Notes || 'No further notes.' }}\n\nRules:\n- Write in the language of the topic, typically German, in a clear, natural “Du” tone if the topic is German.\n- Keep the text short enough for common networks, usually under 1,800 characters.\n- Do not invent facts, offers or numbers that are not in the topic or the notes.\n- Do not add a list of hashtags unless the notes ask for them."
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "7f766289-33fe-4987-a4ac-350d617f02f6",
      "name": "Create the draft",
      "type": "n8n-nodes-social-poster.socialPoster",
      "typeVersion": 1,
      "position": [
        1680,
        400
      ],
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "workspace": "",
        "account": "={{ $('Settings').item.json.accountRef }}",
        "caption": "={{ $json.message && $json.message.content ? $json.message.content : ($json.output || $json.text || \"\") }}",
        "additionalFields": {
          "aiGenerated": true
        }
      },
      "credentials": {
        "socialPosterApi": {
          "id": "YOUR_SOCIAL_POSTER_CREDENTIAL",
          "name": "Social Poster API"
        }
      }
    },
