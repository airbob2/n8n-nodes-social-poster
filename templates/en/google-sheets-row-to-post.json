      "parameters": {
        "resource": "post",
        "operation": "createAndSchedule",
        "workspace": "",
        "account": "={{ $('Settings').item.json.accountRef }}",
        "caption": "={{ $json.Caption }}",
        "scheduleMode": "minutes",
        "minutesFromNow": "={{ $('Settings').item.json.minutesFromNow }}",
        "xContentReviewed": false,
        "additionalFields": {
          "link": "={{ $json.Link }}",
          "mediaUrls": "={{ $json.MediaURLs }}",
          "title": "={{ $json.Title }}"
        }
      },
      "credentials": {
        "socialPosterApi": {
          "id": "YOUR_SOCIAL_POSTER_CREDENTIAL",
          "name": "Social Poster API"
        }
      },
      "onError": "continueRegularOutput"
    },
