      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1540,
        60
      ],
      "parameters": {
        "content": "## Result in the sheet\nOn success the workflow writes status `scheduled` and the draft id. On failure it writes `error`.",
        "height": 240,
        "width": 720,
        "color": 7
      }
    },
    {
      "id": "3feb2695-8eb7-4657-b24d-b53857a2f63c",
