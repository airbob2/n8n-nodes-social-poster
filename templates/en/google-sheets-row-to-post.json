          "__rl": true,
          "mode": "id",
          "value": "={{ $('Settings').item.json.sheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').item.json.sheetName }}"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "db4b6a91-257a-442d-82df-93eb968c5377",
      "name": "Only status ready",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        1360,
        400
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": false,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "f352bf1d-6062-4bd6-b9d3-b150550e2fed",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.Status }}",
              "rightValue": "ready"
            },
            {
              "id": "802cccb0-0001-433a-a34a-8908952bcff9",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.Caption }}",
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "051e2f81-0849-5ce3-8bd8-1ac3756f3602",
      "name": "Create the draft",
      "type": "n8n-nodes-social-poster.socialPoster",
      "typeVersion": 1,
      "position": [
        1640,
        400
      ],
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "workspace": "",
        "account": "={{ $('Settings').item.json.accountRef }}",
        "caption": "={{ $json.Caption }}",
        "additionalFields": {
          "link": "={{ $json.Link }}",
          "mediaUrls": "={{ $json.MediaURLs }}",
          "title": "={{ $json.Title }}"
        }
      },
      "credentials": {
        "socialPosterApi": {
          "id": "YOUR_SOCIAL_POSTER_CREDENTIAL",
          "name": "Social Poster API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "9567547a-a588-5cc0-9f06-75655ccc6524",
      "name": "Should it be scheduled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        400
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": false,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cbe9f00a-6490-5fb7-b99d-41dbeebfbd68",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ String($('Settings').item.json.mode || \"\").trim().toLowerCase() }}",
              "rightValue": "schedule"
            },
            {
              "id": "740ee29b-7aee-59a6-a02c-df4c9690c885",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.draft && $json.draft.draft_ref ? $json.draft.draft_ref : \"\" }}",
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "eb277e2b-1f3a-5300-89f7-9899aaf7bd13",
      "name": "Schedule the draft",
      "type": "n8n-nodes-social-poster.socialPoster",
      "typeVersion": 1,
      "position": [
        2200,
        280
      ],
      "parameters": {
        "resource": "post",
        "operation": "scheduleDraft",
        "workspace": "",
        "draftRef": "={{ $('Create the draft').item.json.draft.draft_ref }}",
        "scheduleMode": "minutes",
        "minutesFromNow": "={{ $('Settings').item.json.minutesFromNow }}",
        "xContentReviewed": false
      },
      "credentials": {
        "socialPosterApi": {
          "id": "YOUR_SOCIAL_POSTER_CREDENTIAL",
          "name": "Social Poster API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "4ea5642d-ac7c-5fc1-ba5d-3db47a1d83ad",
      "name": "Write the status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2480,
        400
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Settings').item.json.sheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').item.json.sheetName }}"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "row_number"
          ],
          "value": {
            "row_number": "={{ $('Only status ready').item.json.row_number }}",
            "Status": "={{ $json.error ? \"error\" : ($json.scheduled_at_utc ? \"scheduled\" : \"draft\") }}",
            "DraftRef": "={{ $('Create the draft').item.json.draft && $('Create the draft').item.json.draft.draft_ref ? $('Create the draft').item.json.draft.draft_ref + ($json.error ? \" – \" + $json.error : \"\") : ($json.error || \"error\") }}",
            "ScheduledAt": "={{ $json.scheduled_at_utc || \"\" }}"
          },
          "schema": [
            {
              "id": "Caption",
              "displayName": "Caption",
              "type": "string",
              "display": true,
              "required": false,
