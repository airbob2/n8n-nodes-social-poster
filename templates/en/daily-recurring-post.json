        1280,
        80
      ],
      "parameters": {
        "content": "## Draft, optionally scheduled\nA draft is created only when today has a caption. With `mode` = `schedule`, “Schedule the draft” schedules it and confirms publishing.",
        "height": 260,
        "width": 1100,
        "color": 7
      }
    },
    {
