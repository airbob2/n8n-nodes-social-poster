            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "a18af0bf-b73e-5ebf-9fa7-3685a104cbf6",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ String($('Beitrag vorbereiten').item.json.modus || \"\").trim().toLowerCase() }}",
