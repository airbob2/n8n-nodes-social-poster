      "typeVersion": 1,
      "position": [
        1100,
        60
      ],
      "parameters": {
        "content": "## Konto und Inhalt\nHier stehen Konto-Referenz und Vorlauf. Der Text kommt aus der Anfrage, nicht aus den Anmeldedaten.",
        "height": 240,
        "width": 480,
        "color": 7
      }
    },
    {
      "id": "576da42f-e223-41bb-a61b-6d6c5dcc787a",
